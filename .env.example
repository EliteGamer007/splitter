# ============================================
# Splitter - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Docker Services (optional, for local pgAdmin) ---
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=admin123

# --- Database (Neon Cloud PostgreSQL) ---
# Connection string format: postgresql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME?sslmode=require
DB_HOST=ep-your-endpoint.region.aws.neon.tech
DB_PORT=5432
DB_USER=your_neon_username
DB_PASSWORD=your_neon_password
DB_NAME=neondb

# --- Application ---
PORT=8000
ENV=development
BASE_URL=http://localhost:8000

# --- Security ---
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars

# --- Instance 2 Overrides (used by scripts/run-both-servers.ps1) ---
INSTANCE2_DB_NAME=neondb_2
INSTANCE2_PORT=8001
INSTANCE2_BASE_URL=http://localhost:8001
INSTANCE2_JWT_SECRET=instance-2-jwt-secret-key
INSTANCE2_FEDERATION_DOMAIN=splitter-2
INSTANCE2_FEDERATION_URL=http://localhost:8001

# Free-tier defaults: one primary, no scheduled keep-alive or bot population.
DB_SSLMODE=require
DB_MAX_CONNS=4
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=https://splitter-social.vercel.app
FEDERATION_ENABLED=true
FEDERATION_DOMAIN=splitter-1
FEDERATION_URL=http://localhost:8000
# Explicit peers only; leave absent for a single hosted instance.
# FEDERATION_INSTANCE_MAP=splitter-1=http://localhost:8000,splitter-2=http://localhost:8001
# Development only: exact local endpoints permitted by federation network guards.
# FEDERATION_LOCAL_PEERS=http://localhost:8000,http://localhost:8001
MEDIA_TOTAL_BUDGET_BYTES=33554432
MEDIA_ACCOUNT_BUDGET_BYTES=2097152
DB_WRITE_BUDGET_BYTES=268435456

# Optional public @split replies; leave the key absent for no provider usage.
SPLIT_BOT_API_KEY=
# SPLIT_BOT_PROVIDER=gemini
# SPLIT_BOT_MODEL=<model enabled for your provider account>
SPLIT_BOT_DAILY_LIMIT=10
SPLIT_BOT_USER_DAILY_LIMIT=3
